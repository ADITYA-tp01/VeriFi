# Groq API keys — obtain TWO keys (primary + backup)
GROQ_API_KEY=your_primary_groq_api_key_here
GROQ_API_KEY_BACKUP=your_backup_groq_api_key_here

# Model to use for intent extraction / explanation
GROQ_MODEL=openai/gpt-oss-120b

# urlscan.io key (optional — Tier 3 / --live only)
URLSCAN_API_KEY=

# Set to "1" to enable live API calls (NEVER during demo fixtures)
LIVE=0
